# Sekret ustawiany w panelu dostawcy hostingu, NIE wpisuj go do kodu ani GitHub.
QS_ACCESS_PASSWORD=USTAW_TUTAJ_DLUGIE_LOSOWE_HASLO
# W trybie online HTTPS:
QS_SECURE_COOKIES=true
# Opcjonalnie: biala lista domen dostawcow obrazow, rozdzielana przecinkami
# QS_IMAGE_HOSTS=images.example.com,*.trusted-cdn.com
# Tylko jeśli firmowe IT zatwierdzi pobieranie niezaszyfrowanych zdjęć:
# QS_ALLOW_HTTP_IMAGES=true

# Panel prywatny: osobne hasło administratora, min. 16 znaków.
# QS_ADMIN_PASSWORD=INNE_DLUGIE_LOSOWE_HASLO
# Baza trwała PostgreSQL (np. Render Postgres). Bez niej licznik działa
# na SQLite w /tmp, a historia znika po restarcie/nowym deployu.
# QS_STATS_DATABASE_URL=postgresql://user:password@host:5432/database
# Alternatywnie lokalna ścieżka SQLite na trwałym dysku:
# QS_STATS_DB_PATH=/data/quicksilver-usage.sqlite3
