# Sekret ustawiany w panelu dostawcy hostingu, NIE wpisuj go do kodu ani GitHub.
QS_ACCESS_PASSWORD=USTAW_TUTAJ_DLUGIE_LOSOWE_HASLO
# W trybie online HTTPS:
QS_SECURE_COOKIES=true
# Opcjonalnie: biala lista domen dostawcow obrazow, rozdzielana przecinkami
# QS_IMAGE_HOSTS=images.example.com,*.trusted-cdn.com
# Tylko jeśli firmowe IT zatwierdzi pobieranie niezaszyfrowanych zdjęć:
# QS_ALLOW_HTTP_IMAGES=true
